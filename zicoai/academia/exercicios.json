  "html": "<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Estoque</title><style>body{font-family:system-ui;background:#111;color:#eee;padding:16px}input,button{font-size:16px;margin:4px;padding:6px}</style></head><body><h1>Estoque</h1>\n<button id=\"menos\">−</button> <b id=\"qtd\">1</b> <button id=\"mais\">+</button>\n<script>\nvar q = 1;\nfunction mostra(){ document.getElementById('qtd').textContent = q; }\ndocument.getElementById('menos').onclick = function(){ q--; mostra(); };\ndocument.getElementById('mais').onclick = function(){ q++; mostra(); };\n</script></body></html>",
