[
 {
  "id": "gorjeta-por-pessoa",
  "nome": "Gorjeta: total por pessoa",
  "pedido": "na calculadora de gorjeta o \"Por pessoa\" tá errado: conta 100, gorjeta 10%, 2 pessoas tem que dar R$ 55,00 e tá dando R$ 110,00. corrige",
  "html": "<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Gorjeta</title><style>body{font-family:system-ui;background:#111;color:#eee;padding:16px}input,button{font-size:16px;margin:4px;padding:6px}</style></head><body><h1>Gorjeta</h1>\n<label>Conta <input id=\"conta\" inputmode=\"decimal\"></label><br>\n<label>Gorjeta % <input id=\"pct\" value=\"10\"></label><br>\n<label>Pessoas <input id=\"pessoas\" value=\"1\"></label><br>\n<button id=\"calc\">Calcular</button>\n<p>Por pessoa: <b id=\"porPessoa\">R$ 0,00</b></p>\n<script>\nfunction num(t){ return parseFloat(String(t).replace(',', '.')) || 0; }\nfunction brl(v){ return 'R$ ' + v.toFixed(2).replace('.', ','); }\ndocument.getElementById('calc').onclick = function(){\n  var c = num(document.getElementById('conta').value), p = num(document.getElementById('pct').value);\n  var n = Math.max(1, parseInt(document.getElementById('pessoas').value) || 1);\n  var total = c + c * p / 100;\n  document.getElementById('porPessoa').textContent = brl(total);\n};\n</script></body></html>",
  "conserto": [
   [
    "document.getElementById('porPessoa').textContent = brl(total);",
    "document.getElementById('porPessoa').textContent = brl(total / n);"
   ]
  ],
  "provas": [
   {
    "nome": "100 + 10% em 2 = 55,00",
    "passos": [
     {
      "preencher": "#conta",
      "valor": "100"
     },
     {
      "preencher": "#pct",
      "valor": "10"
     },
     {
      "preencher": "#pessoas",
      "valor": "2"
     },
     {
      "clicar": "#calc"
     }
    ],
    "conferir": [
     {
      "texto": "#porPessoa",
      "contem": "R$ 55,00"
     }
    ]
   },
   {
    "nome": "90 + 10% em 3 = 33,00",
    "passos": [
     {
      "preencher": "#conta",
      "valor": "90"
     },
     {
      "preencher": "#pct",
      "valor": "10"
     },
     {
      "preencher": "#pessoas",
      "valor": "3"
     },
     {
      "clicar": "#calc"
     }
    ],
    "conferir": [
     {
      "texto": "#porPessoa",
      "contem": "R$ 33,00"
     }
    ]
   }
  ]
 },
 {
  "id": "lista-apaga-errado",
  "nome": "Lista de compras: apagar o item certo",
  "pedido": "na lista de compras, quando eu apago um item some o item de cima dele em vez dele. corrige",
  "html": "<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Lista</title><style>body{font-family:system-ui;background:#111;color:#eee;padding:16px}input,button{font-size:16px;margin:4px;padding:6px}</style></head><body><h1>Lista de compras</h1>\n<input id=\"item\" placeholder=\"item\"><button id=\"add\">Adicionar</button>\n<ul id=\"lista\"></ul>\n<script>\nvar itens = [];\nfunction desenha(){\n  document.getElementById('lista').innerHTML = itens.map(function(t, i){ return '<li><span>' + t + '</span> <button class=\"del\" data-i=\"' + i + '\">apagar</button></li>'; }).join('');\n}\ndocument.getElementById('add').onclick = function(){\n  var c = document.getElementById('item'); if (!c.value.trim()) return;\n  itens.push(c.value.trim()); c.value = ''; desenha();\n};\ndocument.getElementById('lista').onclick = function(e){\n  if (e.target.classList.contains('del')) { itens.splice(Number(e.target.dataset.i) - 1, 1); desenha(); }\n};\n</script></body></html>",
  "conserto": [
   [
    "itens.splice(Number(e.target.dataset.i) - 1, 1);",
    "itens.splice(Number(e.target.dataset.i), 1);"
   ]
  ],
  "provas": [
   {
    "nome": "apaga o 2º de A,B,C fica A,C",
    "passos": [
     {
      "preencher": "#item",
      "valor": "A"
     },
     {
      "clicar": "#add"
     },
     {
      "preencher": "#item",
      "valor": "B"
     },
     {
      "clicar": "#add"
     },
     {
      "preencher": "#item",
      "valor": "C"
     },
     {
      "clicar": "#add"
     },
     {
      "clicar": "#lista li:nth-child(2) .del"
     }
    ],
    "conferir": [
     {
      "js": "var t=[...document.querySelectorAll('#lista li span')].map(s=>s.textContent).join(','); return t==='A,C' || ('ficou: '+t)"
     }
    ]
   },
   {
    "nome": "apaga o 1º de A,B fica B",
    "passos": [
     {
      "preencher": "#item",
      "valor": "A"
     },
     {
      "clicar": "#add"
     },
     {
      "preencher": "#item",
      "valor": "B"
     },
     {
      "clicar": "#add"
     },
     {
      "clicar": "#lista li:nth-child(1) .del"
     }
    ],
    "conferir": [
     {
      "js": "var t=[...document.querySelectorAll('#lista li span')].map(s=>s.textContent).join(','); return t==='B' || ('ficou: '+t)"
     }
    ]
   }
  ]
 },
